# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram channel ID (e.g., @your_channel_name or -1001234567890)
TELEGRAM_CHANNEL_ID=@uni_burn_alerts

# RPC Configuration (optional)
# No longer required — uses free public RPCs (publicnode.com) by default
# ALCHEMY_API_KEY=your_alchemy_api_key

# PostgreSQL Database Connection
# Required - Railway provides POSTGRES_URL automatically
DATABASE_URL=postgresql://user:password@localhost:5432/uniburn

# Monitoring Configuration
# How often to check for new burns (in seconds)
POLL_INTERVAL_SECONDS=60

# Amount threshold to trigger alerts (in wei)
# 4000 UNI = 4000000000000000000000
AMOUNT_THRESHOLD=4000000000000000000000

# Multi-chain Configuration
# Comma-separated list of chains to monitor
# Available: ethereum, unichain, arbitrum, base, optimism, worldchain, celo, soneium, xlayer, zora
# Default: ethereum (if not set, only Ethereum mainnet is monitored)
ENABLED_CHAINS=ethereum

# Uniswap Trading API Key (optional)
# Enables live USD price enrichment for burn alerts
# Get a key at https://hub.uniswap.org/
UNISWAP_API_KEY=your_uniswap_api_key

# Digest Configuration (optional)
# Send daily/weekly burn summary messages to the channel
DIGEST_ENABLED=false
# Hour (UTC) to send daily digest (0-23, default: 12 = noon UTC)
DIGEST_DAILY_HOUR=12
# Day of week for weekly digest (0=Sunday, 1=Monday, ..., default: 1 = Monday)
DIGEST_WEEKLY_DAY=1
